<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <provider
            android:name="org.dhis2.mobile.aichat.data.AiChatProvider"
            android:authorities="${applicationId}.aichat.data.AiChatFileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ai_chat_file_paths"
                tools:node="merge" />
        </provider>

        <activity
            android:name="org.dhis2.mobile.aichat.ui.AiChatActivity"
            android:exported="false" />
    </application>
</manifest>
